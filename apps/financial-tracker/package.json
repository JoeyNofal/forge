{
  "name": "financial-tracker",
  "version": "1.0.0",
  "description": "Vault — Personal Financial Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node datastore.test.js && node session.test.js && node dates.test.js && node main.test.js && node renderer.test.js && node pagedates.test.js",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.youss.financialtracker",
    "productName": "Vault Financial Tracker",
    "win": {
      "target": ["portable"],
      "icon": "icon.png"
    },
    "files": ["main.js", "preload.js", "datastore.js", "session.js", "dates.js", "index.html", "vendor/**/*"]
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "jsdom": "^30.0.0"
  }
}
